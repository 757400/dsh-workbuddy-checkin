    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/757400/dsh-workbuddy-checkin.git"
  },
  "homepage": "https://github.com/757400/dsh-workbuddy-checkin#readme",
  "bugs": {
    "url": "https://github.com/757400/dsh-workbuddy-checkin/issues"
  },
  "author": {
    "name": "757400"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
